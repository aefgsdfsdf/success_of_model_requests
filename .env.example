DB_HOST=uaudithost.fineres.com
DB_PORT=9009
DB_USER=replace_with_database_user
DB_PASSWORD=replace_with_database_password
DB_NAME=oneapi
# Use ms for Unix milliseconds, s for Unix seconds.
DB_TIMESTAMP_UNIT=s
APP_PORT=8080
# Maximum number of new logs handled by one minute task run.
DB_INCREMENT_BATCH_SIZE=10000
# Maximum incremental batches processed in each minute tick.
DB_MAX_BATCHES_PER_TICK=1
# Number of latest logs to seed when the grouped summary table is empty.
DB_INITIAL_SEED_ROWS=0
